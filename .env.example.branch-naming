# Environment Configuration for Branch Naming
# Copy to .env or set as environment variables

# Branch naming patterns - only 2 categories needed
BRANCH_PREFIX_PIPELINE=fix/pipeline_
BRANCH_PREFIX_QUALITY=fix/sonarqube_

# Example of alternative branch naming patterns:
# BRANCH_PREFIX_PIPELINE=cicd-assistant/pipeline_
# BRANCH_PREFIX_QUALITY=cicd-assistant/quality_

# Or use a different organizational pattern:
# BRANCH_PREFIX_PIPELINE=automated-fix/pipeline-
# BRANCH_PREFIX_QUALITY=automated-fix/quality-

# Other existing environment variables...
# DATABASE_URL=postgresql://cicd_assistant:secure_password@postgres-assistant:5432/cicd_assistant
# GITLAB_URL=http://gitlab
# GITLAB_TOKEN=your-gitlab-token
# SONAR_HOST_URL=http://sonarqube:9000
# SONAR_TOKEN=your-sonar-token
